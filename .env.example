# ==========================================
# META APP (Facebook Developer Console)
# ==========================================
META_APP_ID=your_app_id_here
META_APP_SECRET=your_app_secret_here
META_GRAPH_API_VERSION=v19.0
META_GRAPH_API_BASE_URL=https://graph.facebook.com

# ==========================================
# META / INSTAGRAM / MESSENGER
# ==========================================
META_VERIFY_TOKEN=your_random_verify_token_here
META_ACCESS_TOKEN=your_page_access_token_here
META_PAGE_ID=your_page_id_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# Optional MESSENGER_* aliases (override META_* if set)
MESSENGER_PAGE_ACCESS_TOKEN=your_page_access_token_here
MESSENGER_VERIFY_TOKEN=your_random_verify_token_here
MESSENGER_APP_ID=your_app_id_here
MESSENGER_APP_SECRET=your_app_secret_here

# Optional shared-secret used to authenticate
# inbound internal API calls (e.g. `openssl rand -hex 32`)
INTERNAL_API_TOKEN=your_random_64char_hex_here

# ==========================================
# WHATSAPP BUSINESS API (Meta Cloud API)
# ==========================================
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ============================================
# OPENAI
# ============================================
OPENAI_API_KEY=

# Available models (best to cheapest):
# gpt-5         - $5/$30 per 1M - best quality
# gpt-4.1-mini  - $0.40/$1.60   - recommended balance
# gpt-4o        - $2.50/$10     - older, more expensive
# gpt-4o-mini   - $0.15/$0.60   - cheapest
OPENAI_MODEL=gpt-4.1-mini

# ============================================
# ANTHROPIC / CLAUDE  (optional backend)
# ============================================
# Which backend serves every LLM call. Leave "openai" to keep today's
# behaviour exactly; set "anthropic" to run the agent on Claude.
LLM_PROVIDER=openai

# Accepts EITHER credential shape — the code detects which one it got:
#
#   sk-ant-oat…   a SETUP TOKEN. Generate with:  claude setup-token
#                 Billed against your Claude Pro/Max subscription, not
#                 API credits. Requires an active subscription.
#   sk-ant-api…   a classic API key from console.anthropic.com.
#                 Billed per token against API credits.
#
# Paste the value on ONE line with no quotes. Invisible characters from a
# clipboard round-trip are stripped automatically, but a line break is
# not — a wrapped token will fail with 401.
ANTHROPIC_AUTH_TOKEN=

# ANTHROPIC_API_KEY is accepted as an alias for the variable above.

# claude-sonnet-4-6  - recommended balance
# claude-opus-4-6    - highest quality, slowest
# claude-haiku-4-5-20251001 - cheapest / fastest
ANTHROPIC_MODEL=claude-sonnet-4-6

# On an Anthropic failure (expired token, quota, network), retry the same
# request on OpenAI instead of failing the customer's turn. Keep true for
# production; set false while debugging so Claude errors are visible.
ANTHROPIC_FALLBACK_TO_OPENAI=true

# Verify the credential + model together before flipping LLM_PROVIDER:
#   python -m tools.check_anthropic_token

# ==========================================
# GOOGLE SHEETS (CRM)
# ==========================================
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_LEADS_TAB=Leads

# ==========================================
# GOOGLE CALENDAR (BOOKING)
# ==========================================
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# Legacy single-calendar id. Still respected as a fallback when
# `BOOKING_CALENDAR_ID` / `BUSY_CALENDAR_IDS` below are not set —
# the agent writes events to this calendar and reads its FreeBusy
# data for availability. New deploys should leave this blank and
# use `BOOKING_CALENDAR_ID` + `BUSY_CALENDAR_IDS` instead.
GOOGLE_CALENDAR_ID=

# --- Calendar Multi-Busy Check Patch (2026-06-04) -----------------
#
# `BOOKING_CALENDAR_ID` — the calendar where the agent CREATES
# consultation events. Falls back to `GOOGLE_CALENDAR_ID` when unset.
# The agent NEVER writes to any other calendar.
#
# `BUSY_CALENDAR_IDS` — comma-separated list of calendar ids the
# agent must consult for availability (multi-calendar FreeBusy
# check). The booking calendar is ALWAYS included automatically;
# add the manager's main / side calendars here so any busy event
# the operator places on them blocks the corresponding 1-hour slot.
# Falls back to `[BOOKING_CALENDAR_ID]` when empty.
#
# Example (two calendars — bookings + manager main):
#   BOOKING_CALENDAR_ID=ai-bookings@group.calendar.google.com
#   BUSY_CALENDAR_IDS=ai-bookings@group.calendar.google.com,manager@example.com
#
# Every calendar listed in BUSY_CALENDAR_IDS MUST be shared with the
# Google service account credentials used by the agent — otherwise
# the FreeBusy query returns a per-calendar `errors` block and the
# agent fails CLOSED ("slot unavailable" → manager handoff) rather
# than booking blindly.
#
# Reminder: Google Calendar UI's "My calendars" list shows every
# calendar the manager owns — but the agent only checks those
# whose ids you list here. Seeing a busy event in the UI does NOT
# mean the agent sees it unless that calendar's id is in
# BUSY_CALENDAR_IDS.
BOOKING_CALENDAR_ID=
BUSY_CALENDAR_IDS=

# ==========================================
# NOTIFICATIONS
# ==========================================
# Email (Gmail SMTP recommended)
#
# IMPORTANT — Gmail credentials:
#   SMTP_PASSWORD MUST be a Gmail App Password, NOT the regular Gmail
#   password. Regular Gmail passwords are rejected by smtp.gmail.com.
#   Create one at:
#     Google Account → Security → 2-Step Verification → App Passwords
#
# SECURITY:
#   * Never commit a real SMTP_PASSWORD to git.
#   * Never log SMTP_PASSWORD (the sender masks it).
#   * Rotate the App Password if it is ever exposed.
#
# When ENABLE_EMAIL_NOTIFICATIONS=true, the manager email is attempted
# after every successful consultation booking. If MANAGER_EMAIL or any
# SMTP_* variable is missing the sender logs a clear warning and skips
# the email — Calendar / Sheets / WhatsApp continue normally.
ENABLE_EMAIL_NOTIFICATIONS=true
MANAGER_EMAIL=manager@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MANAGER_PHONE_NUMBER=

# WhatsApp notification to manager
MANAGER_WHATSAPP_NUMBER=

# ==========================================
# COMPANY SETTINGS
# ==========================================
COMPANY_NAME=სიტყვის აკადემია
COMPANY_TONE_PARENTS=
COMPANY_TONE_ADULTS=
COMPANY_LANGUAGE=Georgian
KNOWLEDGE_BASE_PATH=./data/knowledge_base.txt
EVENTS_PATH=./data/events.txt

# Camp price - never mention without value explanation
CAMP_PRICE=2200

# ==========================================
# FOLLOW-UP
# ==========================================
FOLLOWUP_HOURS=48
FOLLOWUP_CONTENT_LINK=
FOLLOWUP_COLD_LEAD_HOURS=48

# ==========================================
# SERVER
# ==========================================
PORT=8006

# ============================================
# HASHTAG-BASED POST ROUTING
# ============================================
# Comma-separated hashtags WITHOUT # symbol
# Example: PARENT_HASHTAGS=banaki,bavshvebi,skola
PARENT_HASHTAGS=
ADULT_HASHTAGS=

# ============================================
# COMMENT RESPONSES
# ============================================
COMMENT_FALLBACK_LINK=
COMMENT_FOLLOWUP_HOURS=24
# Gate the public reply to comments. Default ON so the code is ready
# for Meta App Review; once `pages_manage_engagement` is granted and
# the Page Access Token refreshed, public replies auto-activate on
# the next restart — no code change needed. The DM remains the
# primary action: when Meta rejects the public reply (HTTP 400 for
# missing permission, etc.), the handler logs safely and the private
# DM still goes out. Set to false here to force-disable per deploy.
ENABLE_PUBLIC_COMMENT_REPLY=true

# ==========================================
# MESSAGE DEBOUNCE / BATCHING
# Batches user fragments into a single response.
# DEBOUNCE_SECONDS: wait this long after last message before responding
# MAX_WAIT_SECONDS: cap total wait per buffer (even if user keeps typing)
# ==========================================
DEBOUNCE_SECONDS=5
MAX_WAIT_SECONDS=15

# ==========================================
# ADMIN PANEL (operator UI for sections/templates)
# ==========================================
# Default OFF — set ENABLED=true and supply a strong ADMIN_PASSWORD to
# expose the /admin routes. HTTP Basic Auth gates every page. The
# password is never logged. Without ADMIN_PASSWORD the panel refuses
# to load even when ENABLED=true.
ADMIN_PANEL_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ==========================================
# REDIS — restart-safe state persistence (P3-B)
# ==========================================
# Conversation, Lead, pending_booking, manager-notified guard, and
# processed comment IDs are mirrored to Redis (with TTL) so a server
# restart no longer wipes them. The app is SAFE to run without Redis:
# leave REDIS_URL empty (or set REDIS_ENABLED=false) and the legacy
# in-memory behaviour is preserved exactly.
#
# URL formats:
#   Local Redis:           redis://localhost:6379
#   Local with password:   redis://:password@localhost:6379
#   Railway / managed:     redis://default:password@host:port
#   No local Redis:        (leave empty → in-memory only)
#
# SECURITY:
#   The full URL (including any password) is NEVER logged. Boot logs
#   only `url_configured=True/False` and `connected=True/False`.
REDIS_URL=
REDIS_ENABLED=true
# TTL in seconds — default 7 days. Each write refreshes the TTL so
# active conversations stay alive indefinitely.
REDIS_TTL_SECONDS=604800

# ==========================================
# SENTRY / ERROR MONITORING (optional)
# ==========================================
# Leave SENTRY_DSN empty to disable Sentry. The app boots normally
# either way — when DSN is empty OR `sentry-sdk` is not installed,
# all monitoring calls become safe no-ops.
#
# Install for production:
#   pip install "sentry-sdk[fastapi]"
#
# Privacy: the agent forwards ONLY masked sender ids + structural
# labels (area / platform / tool / follow-up stage) to Sentry. Raw
# user messages, phone numbers, full sender IDs, SMTP / OpenAI /
# Meta tokens, Gmail App Password, Google private key, and the
# Redis URL with password are NEVER captured. `send_default_pii`
# is hard-coded to False in app/services/sentry_service.py.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Float in [0.0, 1.0]. Out-of-range values are clamped at init
# (never crashes boot).
SENTRY_TRACES_SAMPLE_RATE=0.0

# ==========================================
# WEBHOOK SIGNATURE VERIFICATION (HMAC-SHA256)
# ==========================================
# Meta signs every POST /webhook body with HMAC-SHA256 keyed on the
# Page App Secret and ships the result in the `X-Hub-Signature-256`
# header (`sha256=<hex>`). When this flag is true AND META_APP_SECRET
# is also set, the agent rejects any request whose signature fails
# the constant-time comparison.
#
# Fail-open semantics: VERIFY_WEBHOOK_SIGNATURE=true BUT
# META_APP_SECRET empty → handler logs ONE warning and skips
# verification, so legacy / local-dev installs keep working until the
# secret is propagated.
#
# To actually enforce in production:
#   1. Add the Page App Secret in META_APP_SECRET (or
#      MESSENGER_APP_SECRET — alias).
#   2. Keep VERIFY_WEBHOOK_SIGNATURE=true.
#   3. Restart.
VERIFY_WEBHOOK_SIGNATURE=true

# ==========================================
# EMERGENCY KILL SWITCH
# ==========================================
# Operator-controlled disable. No code change needed.
#   true  → agent processes messages normally (default).
#   false → agent returns the safe offline message on every DM
#           and skips every comment-DM / follow-up tick. No
#           OpenAI / Calendar / Sheets / email / Meta-send calls
#           are made. /webhook GET verify, /health, and /admin
#           continue to work so Meta does not de-list the webhook
#           and the operator can flip the flag back from /admin.
# Missing AGENT_ENABLED line → defaults to true (live).
AGENT_ENABLED=true

# ==========================================
# LLM ENGINE FEATURE FLAGS
# ==========================================
# Phase 3.8 — discovery composer (LLM rewrites the 4 discovery turns).
USE_LLM_COMPOSER=false
# Phase 3.9 — LLM intent analyzer as fallback for the deterministic detector.
USE_LLM_TURN_ANALYZER=false
# P3-C SAFE — PARENT LLM engine with backend-validated tool calling.
# Default off. When true, the LLM engine runs first; failure/empty falls
# back to the existing P0/P1/P2 state machine.
USE_PARENT_LLM_ENGINE=false
# ADULT LLM engine — mirrors P3-C SAFE for cultural events flow.
# Default ON. When true, conversation_service routes ADULT messages
# through app/agent/llm/adult_llm_engine.run_adult_llm_turn (events
# tool registry + min_age filter + reservation link + manager handoff
# + parent-flow switch). On any exception or empty response, falls back
# to the legacy adult_flow state machine.
USE_ADULT_LLM_ENGINE=true
# Conversation Planner (Reasoning Layer Phase 3) — deterministic, metadata-only
# planning layer. SHADOW (log-only) when only USE_CONVERSATION_PLANNER is true;
# AUTHORITATIVE (constrains routing/answer) when BOTH are true. Default OFF.
USE_CONVERSATION_PLANNER=false
CONVERSATION_PLANNER_AUTHORITATIVE=false
# Per-turn diagnostic trace — one compact `[trace] {...}` block per inbound
# turn (route / planner / handler / prompt mode / selected_state / validator /
# masked lead state). Observability only. Default OFF.
CONVERSATION_TRACE_DEBUG=false
# Slim Prompt / Topic-Scoped Context (Phase 3 Stage 2.2). When true AND the
# planner is authoritative, the engines load the short core prompts
# (parent_core.md / adult_core.md) instead of system_parent_v2.md /
# system_adult_v1.md, and inject only planner policy + selected_state +
# topic-scoped knowledge. Default OFF (giant prompts loaded as before).
USE_SLIM_PROMPTS=false
